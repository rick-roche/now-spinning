# Development defaults
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/now-spinning.sqlite
PUBLIC_APP_ORIGIN=http://localhost:5173
LASTFM_CALLBACK_URL=http://localhost:3000/api/auth/lastfm/callback
DISCOGS_CALLBACK_URL=http://localhost:3000/api/auth/discogs/callback
LASTFM_API_KEY=
LASTFM_API_SECRET=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
TOKEN_ENCRYPTION_KEY=
DEV_MODE=true

# Optional. Keep empty for same-origin production requests.
ALLOWED_ORIGINS=

# Required production overrides
# NODE_ENV=production
# DATABASE_PATH=/data/now-spinning.sqlite
# PUBLIC_APP_ORIGIN=https://now-spinning.rickroche.com
# LASTFM_CALLBACK_URL=https://now-spinning.rickroche.com/api/auth/lastfm/callback
# DISCOGS_CALLBACK_URL=https://now-spinning.rickroche.com/api/auth/discogs/callback
# DEV_MODE=false
# TOKEN_ENCRYPTION_KEY=<base64-encoded 32-byte key>

# Preview overrides
# NODE_ENV=production
# DATABASE_PATH=/tmp/now-spinning.sqlite
# PUBLIC_APP_ORIGIN=https://123.preview.now-spinning.rickroche.com
# LASTFM_CALLBACK_URL=https://123.preview.now-spinning.rickroche.com/api/auth/lastfm/callback
# DISCOGS_CALLBACK_URL=https://123.preview.now-spinning.rickroche.com/api/auth/discogs/callback
# DEV_MODE=true
# STATIC_ROOT=/app/apps/web/dist
